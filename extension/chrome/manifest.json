{
  "manifest_version": 3,
  "name": "Cubix Agent",
  "version": "0.1",
  "permissions": ["activeTab", "scripting", "sidePanel"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_title": "Открыть Cubix Lite"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}